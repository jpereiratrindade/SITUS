# SITUS — Configuração local (copiar para .env e ajustar segredos)
# Bind estritamente local (loopback)
SITUS_HTTP_HOST=127.0.0.1
SITUS_HTTP_PORT=8096

# Instância PostGIS dedicada (Podman rootless)
SITUS_DB_HOST=127.0.0.1
SITUS_DB_PORT=55436
SITUS_DB_NAME=situs
SITUS_DB_ADMIN_USER=situs_migrator
SITUS_DB_ADMIN_PASSWORD=change_me_migrator_local
SITUS_DB_QUERY_USER=situs_reader
SITUS_DB_QUERY_PASSWORD=change_me_reader_local

# Armazenamento local aprovado (fora do Git)
SITUS_DATA_DIR=var/data
SITUS_CONFIG_DIR=config
SITUS_WEB_DIR=web
SITUS_EXECUTION_CONFIG=config/execution.example.json

# Limites de segurança e privacidade
SITUS_MAX_BODY_BYTES=1048576
SITUS_MAX_POLYGON_VERTICES=5000
SITUS_MAX_QUERY_AREA_KM2=5000
SITUS_MAX_RADIUS_M=50000

# Camada ambiental raster local aprovada (opcional)
SITUS_RASTER_APPROVED=0
SITUS_RASTER_PATH=
SITUS_RASTER_SOURCE_ID=mapbiomas_campos_rs_2023
SITUS_RASTER_VERSION=2023.col9
